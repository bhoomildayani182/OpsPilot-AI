# Copy to .env; credentials stay in the AWS SDK credential chain.
OPSPILOT_AWS_PROFILE=
AWS_REGION=us-east-1
# Required for Bedrock mode; discover a model available in your account/region.
BEDROCK_MODEL_ID=
STRANDS_DECIDER_URL=http://127.0.0.1:8099
DECIDER_MODEL_ID=strands-decider-2B-qwen3.5-v1-2610
DECIDER_TIMEOUT_SECONDS=120
DECIDER_MIN_CONFIDENCE=0.35
